# OpenAI API Key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File upload limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
MAX_EXTRACTED_TEXT_CHARS=1000000
DOCUMENT_RETENTION_HOURS=24

# Vector DB path (ChromaDB local)
CHROMADB_PATH=./chroma_db

# MyScheme API base URL (official)
MYSCHEME_API_BASE=https://api.myscheme.gov.in

# Reserved for a future data.gov.in integration; not used by scheme search currently.
DATA_GOV_API_KEY=your_data_gov_api_key_here

# LLM model to use
OPENAI_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
