# ==========================================
# JanSahayak AI — .gitignore
# ==========================================

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python

# ChromaDB vector store (local, regenerated)
backend/chroma_db/

# Uploaded documents (user data)
backend/uploads/

# Generated audio files
backend/audio_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
frontend/.next/
frontend/out/
frontend/build/

# Vercel
.vercel

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# OS
Thumbs.db
